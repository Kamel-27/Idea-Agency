# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Make.com custom webhook for Flow A (lead capture).
# Leave empty in development: leads are printed in the terminal instead.
MAKE_WEBHOOK_URL=

# Backup Inbox: Google Apps Script web app in the CRM Sheet (automation/apps-script/).
# Saves step 1 and every complete lead, so no lead is lost if Make is down or out of operations.
# INBOX_SECRET must match the INBOX_SECRET Script Property in Apps Script.
INBOX_URL=
INBOX_SECRET=
